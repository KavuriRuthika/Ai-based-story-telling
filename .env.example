# KathaQuest - AI-Based Story Creation Platform

## Backend Configuration (.env in backend/)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Models: gpt-4o-mini (recommended for cost-effectiveness)

# Database Configuration
DATABASE_URL=sqlite:///./kathaquest.db
# PostgreSQL example: postgresql://user:password@localhost/kathaquest

# Environment
ENVIRONMENT=development
DEBUG=True

# Feature Flags
ENABLE_VOICE_FEATURES=True
ENABLE_IMAGE_GENERATION=True
ENABLE_ADAPTIVE_LEARNING=True

# Session Configuration
SESSION_TIMEOUT=3600
MAX_STORY_SCENES=100

# Logging
LOG_LEVEL=INFO

## Frontend Configuration (.env in frontend/)
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=KathaQuest
VITE_APP_VERSION=1.0.0
VITE_ENABLE_VOICE=true
VITE_ENABLE_IMAGES=true
VITE_DEFAULT_LANGUAGE=en
